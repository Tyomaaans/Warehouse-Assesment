APP_ENV=development
HTTP_PORT=8080
POSTGRES_USER=warehouse
POSTGRES_DB=warehouse
POSTGRES_PASSWORD=replace-with-local-database-password
RABBITMQ_USER=warehouse
RABBITMQ_PASSWORD=replace-with-local-broker-password
WAREHOUSE_SUBNET=172.30.80.0/24
WAREHOUSE_IP_RANGE=172.30.80.128/25
NGINX_IP=172.30.80.2

# For running the binary directly; Compose uses its internal service addresses.
APP_PORT=8080
DATABASE_URL=postgres://warehouse:replace-with-local-database-password@127.0.0.1:5432/warehouse?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://warehouse:replace-with-local-broker-password@127.0.0.1:5672/
TRUSTED_PROXIES=
